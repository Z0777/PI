  5. btnAgrupar . OnSelect   (reemplazar todo)
==============================================================================

ClearCollect(colGEst; {GN: 0; Crop: ""; LastMin: varIniPlan});;
ClearCollect(colOrdG;
    If(varGBase = "early";
       SortByColumns(SortByColumns(colVCR; "Early"; SortOrder.Ascending);
                     "Cultivo"; SortOrder.Ascending);
       SortByColumns(SortByColumns(colVCR; "Early"; SortOrder.Ascending);
                     "Cultivo"; SortOrder.Ascending)));;

ForAll(colOrdG As V;
    Patch(colGEst; First(colGEst);
        {GN: If(V.Cultivo <> First(colGEst).Crop
                || V.Early > DateAdd(First(colGEst).LastMin; varProx; TimeUnit.Days);
                First(colGEst).GN + 1; First(colGEst).GN);
         Crop: V.Cultivo;
         LastMin: If(V.Cultivo <> First(colGEst).Crop
                     || V.Early > DateAdd(First(colGEst).LastMin; varProx; TimeUnit.Days);
                     V.Last;
                     If(V.Last < First(colGEst).LastMin; V.Last; First(colGEst).LastMin))});;
    Patch(colVCR; LookUp(colVCR; VCRID = V.VCRID); {Gid: First(colGEst).GN}));;

ClearCollect(colGrupos;
    ForAll(Distinct(colVCR; Gid) As G;
        With({it: Filter(colVCR; Gid = G.Value)};
            {Gid: G.Value;
             Cultivo: First(it).Cultivo;
             ES: First(it).ES;
             Hex: First(it).Hex;
             Ini: First(SortByColumns(it; "Early"; SortOrder.Ascending)).Early;
             Fin: First(SortByColumns(it; "Last"; SortOrder.Descending)).Last;
             Comun: First(SortByColumns(it; "Last"; SortOrder.Ascending)).Last;
             VCRs: CountRows(it);
             Plantas: Sum(it; Plantas)})));;

