  4. btnAuto . OnSelect   (reemplazar todo)
==============================================================================

Clear(colCiclos);;
Clear(colAsign);;
ClearCollect(colLibre; ForAll(colInv As G; {Cod: G.Cod; Libre: G.Disp}));;
ClearCollect(colPend;
    ForAll(colVCR As V;
        {VCRID: V.VCRID; Nombre: V.Nombre; Cultivo: V.Cultivo; ES: V.ES;
         Early: V.Early; Last: V.Last; TEarly: V.TEarly; TLast: V.TLast;
         Semillero: V.Semillero; Ciclo: V.Ciclo; Ventana: V.Ventana;
         Hex: V.Hex; Rest: V.Plantas}));;

ForAll(Sequence(6) As Pasada;
    ForAll(SortByColumns(colPend; "TLast"; SortOrder.Ascending) As V;

        Collect(colCiclos;
            With({R: LookUp(colPend; VCRID = V.VCRID).Rest;
                  NJ: CountRows(Filter(colCiclos;
                        Cultivo = V.Cultivo && Plantas < Cap
                        && FechaTrasplante >= DateAdd(V.TEarly; -varAgrupar; TimeUnit.Days)
                        && FechaTrasplante <= DateAdd(V.TLast; varAgrupar; TimeUnit.Days)));
                  C: First(SortByColumns(SortByColumns(
                        ForAll(Filter(colInv; Find(";" & V.Cultivo & ";"; Cultivos) > 0) As G;
                            {Cod: G.Cod; Cap: G.Cap; Tipo: G.Tipo;
                             Ini: If(LookUp(colLibre; Cod = G.Cod).Libre >
                                     DateAdd(V.Early; If(G.Tipo = "Directa"; 0; V.Semillero); TimeUnit.Days);
                                     LookUp(colLibre; Cod = G.Cod).Libre;
                                     DateAdd(V.Early; If(G.Tipo = "Directa"; 0; V.Semillero); TimeUnit.Days))});
                        "Cap"; SortOrder.Descending); "Ini"; SortOrder.Ascending))};
                If(R > 0 && NJ = 0 && C.Cod <> "" && C.Ini <= varFinPlan;
                    Table({Lote: "L" & Text(CountRows(colCiclos) + 1; "[$-en-US]000");
                           Inv: C.Cod; Tipo: C.Tipo; Cultivo: V.Cultivo; ES: V.ES;
                           FechaTrasplante: C.Ini;
                           FechaFin: DateAdd(C.Ini; V.Ciclo; TimeUnit.Days);
                           FechaLibre: DateAdd(C.Ini; V.Ciclo + V.Ventana; TimeUnit.Days);
                           Cap: C.Cap; Plantas: 0; Origen: "Auto"; Hex: V.Hex});
                    Filter(colCiclos; false))));;

        Collect(colAsign;
            With({R: LookUp(colPend; VCRID = V.VCRID).Rest;
                  T: If(CountRows(Filter(colCiclos; Plantas = 0)) > 0;
                        First(Filter(colCiclos; Plantas = 0));
                        First(SortByColumns(Filter(colCiclos;
                            Cultivo = V.Cultivo && Plantas < Cap
                            && FechaTrasplante >= DateAdd(V.TEarly; -varAgrupar; TimeUnit.Days)
                            && FechaTrasplante <= DateAdd(V.TLast; varAgrupar; TimeUnit.Days));
                            "FechaTrasplante"; SortOrder.Ascending)))};
                If(R > 0 && T.Lote <> "";
                    Table({Lote: T.Lote; VCRID: V.VCRID; Nombre: V.Nombre;
                           Cultivo: V.Cultivo; ES: V.ES; Inv: T.Inv;
                           Plantas: If(R <= (T.Cap - T.Plantas) + T.Cap * varSobre / 100;
                                       R; T.Cap - T.Plantas);
                           Siembra: DateAdd(T.FechaTrasplante;
                                    -If(T.Tipo = "Directa"; 0; V.Semillero); TimeUnit.Days);
                           Trasplante: T.FechaTrasplante;
                           Fin: T.FechaFin;
                           Estado: If(T.FechaTrasplante >
                                      If(T.Tipo = "Directa"; V.Last; V.TLast);
                                      "Atrasado"; "Programado");
                           Origen: "Auto"; Hex: V.Hex});
                    Filter(colAsign; false))));;

        ForAll(Filter(colCiclos; Plantas = 0) As Z;
            Patch(colCiclos; LookUp(colCiclos; Lote = Z.Lote);
                {Plantas: Sum(Filter(colAsign; Lote = Z.Lote); Plantas)}));;

        ForAll(Filter(colCiclos; Lote = Last(colAsign).Lote) As Z;
            Patch(colCiclos; LookUp(colCiclos; Lote = Z.Lote);
                {Plantas: Sum(Filter(colAsign; Lote = Z.Lote); Plantas)}));;

        ForAll(Filter(colLibre; Cod = Last(colAsign).Inv) As L;
            Patch(colLibre; LookUp(colLibre; Cod = L.Cod);
                {Libre: LookUp(colCiclos; Lote = Last(colAsign).Lote).FechaLibre}));;

        Patch(colPend; LookUp(colPend; VCRID = V.VCRID);
            {Rest: LookUp(colVCR; VCRID = V.VCRID).Plantas
                   - Sum(Filter(colAsign; VCRID = V.VCRID); Plantas)})
    )
);;

ForAll(Filter(colPend; Rest > 0) As V;
    Collect(colAsign;
        {Lote: ""; VCRID: V.VCRID; Nombre: V.Nombre; Cultivo: V.Cultivo; ES: V.ES;
         Inv: "-"; Plantas: V.Rest; Siembra: V.Early; Trasplante: V.Early; Fin: V.Early;
         Estado: "Sin cupo"; Origen: "Auto"; Hex: V.Hex}));;

Select(btnKPI);;
Set(varMsg; "Plan generado: " & CountRows(colCiclos) & " ciclos");;

