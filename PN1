    Set(varMsg; varGh.Cod & " esta ocupado hasta el "
        & Text(LookUp(colLibre; Cod = varGh.Cod).Libre; "[$-es-GT]dd/mm/yyyy"));

    Collect(colCiclos;
        {Lote: "M" & Text(CountRows(colCiclos) + 1; "[$-en-US]000");
         Inv: varGh.Cod; Tipo: varGh.Tipo;
         Cultivo: First(colSelV).Cultivo; ES: First(colSelV).ES;
         FechaTrasplante: varT;
         FechaFin: DateAdd(varT; First(colSelV).Ciclo; TimeUnit.Days);
         FechaLibre: DateAdd(varT; First(colSelV).Ciclo + First(colSelV).Ventana; TimeUnit.Days);
         Cap: varGh.Cap; Plantas: 0; Origen: "Manual"; Hex: First(colSelV).Hex})
);;

Set(varLoteM; Last(colCiclos).Lote);;

ForAll(SortByColumns(colSelV; "TLast"; SortOrder.Ascending) As V;
    Collect(colAsign;
        With({L: LookUp(colCiclos; Lote = varLoteM);
              usado: Sum(Filter(colAsign; Lote = varLoteM); Plantas);
              rest: V.Plantas - Sum(Filter(colAsign; VCRID = V.VCRID && Estado <> "Sin cupo"); Plantas)};
            If(L.Origen = "Manual" && rest > 0 && usado < L.Cap;
                Table({Lote: L.Lote; VCRID: V.VCRID; Nombre: V.Nombre;
                       Cultivo: V.Cultivo; ES: V.ES; Inv: L.Inv;
                       Plantas: If(rest <= L.Cap - usado + L.Cap * varSobre / 100;
                                   rest; L.Cap - usado);
                       Siembra: DateAdd(L.FechaTrasplante;
                                -If(L.Tipo = "Directa"; 0; V.Semillero); TimeUnit.Days);
                       Trasplante: L.FechaTrasplante; Fin: L.FechaFin;
                       Estado: If(L.FechaTrasplante > If(L.Tipo = "Directa"; V.Last; V.TLast);
                                  "Atrasado"; "Programado");
                       Origen: "Manual"; Hex: V.Hex});
                Filter(colAsign; false)))));;

Patch(colCiclos; LookUp(colCiclos; Lote = varLoteM);
    {Plantas: Sum(Filter(colAsign; Lote = varLoteM); Plantas)});;
Patch(colLibre; LookUp(colLibre; Cod = varGh.Cod);
    {Libre: LookUp(colCiclos; Lote = varLoteM).FechaLibre});;
