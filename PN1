  6. btnAsignarManual . OnSelect   (reemplazar todo)
==============================================================================

ClearCollect(colSelV; ForAll(colSel As S; LookUp(colVCR; VCRID = S.VCRID)));;
Set(varGh; LookUp(colInv; Cod = drpInvManual.Selected.Cod));;
Set(varT; dtpFechaManual.SelectedDate);;

If(CountRows(colSelV) = 0;
    Set(varMsg; "Selecciona al menos un VCR");
 CountRows(Distinct(colSelV; Cultivo)) > 1;
    Set(varMsg; "El lote debe ser de un solo cultivo");
