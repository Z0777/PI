=ClearCollect(colOcup;
    ForAll(colSemanas As S;
        {Sem:     S.Sem;
         Ini:     S.Ini;
         Plantas: Sum(Filter(colCiclos;
                      FechaTrasplante <= S.Fin && FechaFin >= S.Ini); Plantas);
         Casas:   CountRows(Filter(colCiclos;
                      FechaTrasplante <= S.Fin && FechaFin >= S.Ini))}));;

ClearCollect(colOcupFam;
    ForAll(colSemanas As S;
        {Sem: S.Sem;
         Cuc: Sum(Filter(colCiclos;
                  Find(";" & Cultivo & ";"; varRegCuc) > 0
                  && FechaTrasplante <= S.Fin && FechaFin >= S.Ini); Plantas);
         Sol: Sum(Filter(colCiclos;
                  Find(";" & Cultivo & ";"; varRegSol) > 0
                  && FechaTrasplante <= S.Fin && FechaFin >= S.Ini); Plantas)}));;

Set(varCapTotal; Sum(colInv; Cap));;
Set(varCapCuc;   Sum(Filter(colInv; Find(";Melon;";  Cultivos) > 0); Cap));;
Set(varCapSol;   Sum(Filter(colInv; Find(";Tomato;"; Cultivos) > 0); Cap));;
Set(varUsoCuc;   Coalesce(Max(colOcupFam; Cuc); 0));;
Set(varUsoSol;   Coalesce(Max(colOcupFam; Sol); 0));;

Set(varPedido;   Sum(colVCR; Plantas));;
Set(varColocado; Sum(Filter(colAsign; Estado <> "Sin cupo"); Plantas));;
Set(varSinCupo;  Sum(Filter(colAsign; Estado =  "Sin cupo"); Plantas));;
Set(varAtrasados;
    CountRows(Filter(ForAll(colVCR As V;
        {n: CountRows(Filter(colAsign; VCRID = V.VCRID && Estado = "Atrasado"))}); n > 0)));;
Set(varPartidos;
    CountRows(Filter(ForAll(colVCR As V;
        {n: CountRows(Filter(colAsign; VCRID = V.VCRID && Estado <> "Sin cupo"))}); n > 1)));;
Set(varUtil;
    Sum(ForAll(colCiclos As C;
        {v: C.Plantas * DateDiff(C.FechaTrasplante; C.FechaFin; TimeUnit.Days)/7}); v)
    / Max(1; varCapTotal * varSemanas) * 100);;

ClearCollect(colKPI;
    {Orden:1; Lab:"Plants requested";
     Val: Text(varPedido; "#,##0");
     Sub: CountRows(colVCR) & " active VCR"; Alerta:"n"};
    {Orden:2; Lab:"Plants placed";
     Val: Text(varColocado; "#,##0");
     Sub: Text(varColocado / Max(1; varPedido); "[$-en-US]0%") & " of demand";
     Alerta: If(varColocado >= varPedido; "ok"; "n")};
    {Orden:3; Lab:"No space in horizon";
     Val: Text(varSinCupo; "#,##0");
