==============================================================================
6. btnAuto      (motor optimizado + regla de 20 dias)
==============================================================================

LA REGLA QUE PEDISTE
-----------------------------------------------------------------------------
"si despues de que pasan 20 dias despues de Last start date ese VCR queda
cancelado, ya no puede asignarse, pero si aun quedan 20 dias aun puede
asignarse."

Se implementa asi:
     Vence    = LatestStartDate + varGracia      (varGracia = 20, editable)
     Expirado = Today() > Vence
y colPend solo recibe los VCR con !Expirado. Un VCR vencido no recibe
asignacion nueva; si ya tenia asignacion de antes, se la queda. Los vencidos
NO entran a "Sin cupo": salen en su propio KPI y con estatus "Expired" en
galVCR, para que no te ensucien el conteo de demanda sin cupo.

Los 20 dias los controlas desde inpVentana (ver punto 6.2), que hoy esta
invisible y sin usar.

6.1  OPTIMIZACIONES DEL MOTOR
-----------------------------------------------------------------------------
  a) El bloque  ForAll(Filter(colCiclos; Plantas = 0) As Z; Patch(...))  barria
     TODOS los lotes en cada una de las 1.116 iteraciones. Se elimina y se
     sustituye por un solo RemoveIf(colCiclos; Plantas <= 0) al final.
  b) Last(colAsign) se evaluaba tres veces por iteracion. Ahora se calcula una
     vez con With({U: Last(colAsign)}).
  c) Los dos LookUp(colLibre; Cod = G.Cod) por casa (68 lookups por VCR) se
     reducen a uno con With({L: ...; E: ...}).
  d) CountRows(Filter(colCiclos; Plantas = 0)) + First(Filter(...)) eran dos
     barridos; ahora es uno con With({Z: ...}).
  e) El lote vacio que se reutiliza ahora exige Cultivo = V.Cultivo. Antes
     podia agarrar un lote vacio de otro cultivo.

Control:    btnAuto
Tipo:       Classic/Button
Ubicacion:  conApp > conHeader > conCtrl
Propiedad:  OnSelect
Accion:     REEMPLAZAR COMPLETO

=Clear(colCiclos);;
Clear(colAsign);;
ClearCollect(colLibre; ForAll(colInv As G; {Cod: G.Cod; Libre: G.Disp}));;
ClearCollect(colPend;
    ForAll(Filter(colVCR; !Expirado) As V;
        {VCRID: V.VCRID; Nombre: V.Nombre; Cultivo: V.Cultivo; ES: V.ES;
         Early: V.Early; Last: V.Last; TEarly: V.TEarly; TLast: V.TLast;
         Semillero: V.Semillero; Ciclo: V.Ciclo; Ventana: V.Ventana;
         Hex: V.Hex; Rest: V.Plantas}));;

ForAll(Sequence(6) As Pasada;
    ForAll(SortByColumns(colPend; "TLast"; SortOrder.Ascending) As V;

        Collect(colCiclos;
            With({R: LookUp(colPend; VCRID = V.VCRID).Rest;
                  NJ: CountRows(Filter(colCiclos;
                        Cultivo = V.Cultivo && Plantas < Cap
                        && FechaTrasplante >= DateAdd(V.TEarly; -varAgrupar; TimeUnit.Days)
                        && FechaTrasplante <= DateAdd(V.TLast; varAgrupar; TimeUnit.Days)));
                  C: First(SortByColumns(SortByColumns(
                        ForAll(Filter(colInv; Find(";" & V.Cultivo & ";"; Cultivos) > 0) As G;
                            With({L: LookUp(colLibre; Cod = G.Cod).Libre;
                                  E: DateAdd(V.Early;
                                        If(G.Tipo = "Direct"; 0; V.Semillero); TimeUnit.Days)};
                                {Cod: G.Cod; Cap: G.Cap; Tipo: G.Tipo; Ini: If(L > E; L; E)}));
                        "Cap"; SortOrder.Descending); "Ini"; SortOrder.Ascending))};
                If(R > 0 && NJ = 0 && C.Cod <> "" && C.Ini <= varFinPlan;
                    Table({Lote: "L" & Text(CountRows(colCiclos) + 1; "[$-en-US]000");
                           Inv: C.Cod; Tipo: C.Tipo; Cultivo: V.Cultivo; ES: V.ES;
                           FechaTrasplante: C.Ini;
                           FechaFin:   DateAdd(C.Ini; V.Ciclo; TimeUnit.Days);
                           FechaLibre: DateAdd(C.Ini; V.Ciclo + V.Ventana; TimeUnit.Days);
                           Cap: C.Cap; Plantas: 0; Origen: "Auto"; Hex: V.Hex});
                    Filter(colCiclos; false))));

        Collect(colAsign;
            With({R: LookUp(colPend; VCRID = V.VCRID).Rest;
                  Z: First(Filter(colCiclos; Plantas = 0 && Cultivo = V.Cultivo))};
                With({T: If(!IsBlank(Z.Lote);
                            Z;
                            First(SortByColumns(Filter(colCiclos;
                                Cultivo = V.Cultivo && Plantas < Cap
                                && FechaTrasplante >= DateAdd(V.TEarly; -varAgrupar; TimeUnit.Days)
                                && FechaTrasplante <= DateAdd(V.TLast; varAgrupar; TimeUnit.Days));
                                "FechaTrasplante"; SortOrder.Ascending)))};
                    If(R > 0 && T.Lote <> "";
                        Table({Lote: T.Lote; VCRID: V.VCRID; Nombre: V.Nombre;
                               Cultivo: V.Cultivo; ES: V.ES; Inv: T.Inv;
                               Plantas: If(R <= (T.Cap - T.Plantas) + T.Cap * varSobre / 100;
                                           R; T.Cap - T.Plantas);
                               Siembra: DateAdd(T.FechaTrasplante;
                                        -If(T.Tipo = "Direct"; 0; V.Semillero); TimeUnit.Days);
                               Trasplante: T.FechaTrasplante;
                               Fin: T.FechaFin;
                               Estado: If(T.FechaTrasplante >
                                          If(T.Tipo = "Direct"; V.Last; V.TLast);
                                          "Atrasado"; "Programado");
                               Origen: "Auto"; Hex: V.Hex});
                        Filter(colAsign; false)))));

        With({U: Last(colAsign)};
            Patch(colCiclos; LookUp(colCiclos; Lote = U.Lote);
                {Plantas: Sum(Filter(colAsign; Lote = U.Lote); Plantas)});;
            Patch(colLibre; LookUp(colLibre; Cod = U.Inv);
                {Libre: LookUp(colCiclos; Lote = U.Lote).FechaLibre});;
            Patch(colPend; LookUp(colPend; VCRID = V.VCRID);
                {Rest: LookUp(colVCR; VCRID = V.VCRID).Plantas
                       - Sum(Filter(colAsign; VCRID = V.VCRID); Plantas)}))
    ));;

RemoveIf(colCiclos; Plantas <= 0);;

ForAll(Filter(colPend; Rest > 0) As V;
    Collect(colAsign;
        {Lote: ""; VCRID: V.VCRID; Nombre: V.Nombre; Cultivo: V.Cultivo; ES: V.ES;
         Inv: "-"; Plantas: V.Rest; Siembra: V.Early; Trasplante: V.Early; Fin: V.Early;
         Estado: "Sin cupo"; Origen: "Auto"; Hex: V.Hex}));;

Select(btnKPI);;
Set(varMsg; "Plan ready: " & CountRows(colCiclos) & " cycles")

