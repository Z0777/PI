==============================================================================
12. btnGuardar: ESCRITURA MASIVA + ESTATUS DE VUELTA
==============================================================================

Dos cambios:
  - Los dos ForAll(... Patch(..., Defaults(...), {...})) se cambian por
    Collect(lista; ForAll(coleccion; {...})). Patch fila por fila manda una
    llamada por registro; Collect con una tabla las manda por lotes. Con 400
    asignaciones la diferencia es de minutos a segundos.
  - Al final escribe el estatus de vuelta a PLN_VCR: Asignado / Parcial /
    Pendiente / Cancelado. Eso es lo que hace que la proxima carga de Excel
    solo te traiga los pendientes.

Control:    btnGuardar
Tipo:       Classic/Button
Ubicacion:  conApp > conHeader > conCtrl
Propiedad:  OnSelect
Accion:     REEMPLAZAR COMPLETO

=RemoveIf(PLN_Ciclos;     Anio = varAnio);;
RemoveIf(PLN_Asignacion; Anio = varAnio);;

Collect(PLN_Ciclos;
    ForAll(colCiclos As C;
        {Title:           C.Lote;
         Invernadero:     C.Inv;
         Cultivo:         C.Cultivo;
         FechaTrasplante: C.FechaTrasplante;
         FechaFinCiclo:   C.FechaFin;
         FechaLibre:      C.FechaLibre;
         PlantasLote:     C.Plantas;
         CapacidadLote:   C.Cap;
         Origen:          {Value: C.Origen};
         Anio:            varAnio}));;

Collect(PLN_Asignacion;
    ForAll(colAsign As A;
        {Title:           A.VCRID & "-" & A.Lote;
         LoteId:          A.Lote;
         VCRID:           A.VCRID;
         VCRName:         A.Nombre;
         Invernadero:     A.Inv;
         Cultivo:         A.Cultivo;
         Plantas:         A.Plantas;
         FechaSiembra:    A.Siembra;
         FechaTrasplante: A.Trasplante;
         FechaFin:        A.Fin;
         SemanaIni:       If(IsBlank(A.Trasplante); 0;
                             RoundDown(DateDiff(varIniPlan; A.Trasplante; TimeUnit.Days)/7; 0) + 1);
         SemanaFin:       If(IsBlank(A.Fin); 0;
                             RoundDown(DateDiff(varIniPlan; A.Fin; TimeUnit.Days)/7; 0) + 1);
         Estado:          {Value: A.Estado};
         Origen:          {Value: A.Origen};
         Anio:            varAnio}));;

ForAll(colVCR As V;
    With({a: Coalesce(LookUp(colVcrEst; VCRID = V.VCRID).Asignado; 0)};
        Patch(PLN_VCR; LookUp(PLN_VCR; VCRID = V.VCRID && Anio = varAnio);
            {Estado: If(a >= V.Plantas; "Asignado";
                        a > 0;         "Parcial";
                        V.Expirado;    "Cancelado";
                        "Pendiente")})));;

Notify("Plan guardado: " & CountRows(colCiclos) & " lotes y " &
       CountRows(colAsign) & " asignaciones"; NotificationType.Success)

Nota: este boton sigue siendo el mas lento de la app por naturaleza (borra y
reescribe el ano completo). Eso es normal y solo pasa cuando tu lo pides.
El UpdateContext({ctxCargando}) que tenias no servia de nada porque ningun
control usa ctxCargando; lo quite. Si quieres un indicador, pon en
lblMsgGlobal.Text el valor =varMsg y escribe varMsg antes y despues.


