varIniPlan = Date(varAnio - 1; 10; 1);;
varFinPlan = Date(varAnio + 1; 3; 1);;
varSemanas = Max(1; RoundUp(DateDiff(varIniPlan; varFinPlan; TimeUnit.Days)/7; 0));;

varRegCuc = ";Melon;Watermelon;Cucumber;";;
varRegSol = ";Tomato;Tomato Cherry;Pepper;";;
varRegTom = ";Tomato;Tomato Cherry;";;

varCapTotal = Sum(colInv; Cap);;
varCapCuc   = Sum(Filter(colInv; Find(";Melon;";  Cultivos) > 0); Cap);;
varCapSol   = Sum(Filter(colInv; Find(";Tomato;"; Cultivos) > 0); Cap);;

colSemanas =
    ForAll(Sequence(varSemanas) As S;
        With({f: DateAdd(varIniPlan; (S.Value-1)*7; TimeUnit.Days)};
            {Sem:    S.Value;
             Ini:    f;
             Fin:    DateAdd(f; 6; TimeUnit.Days);
             WN:     WeekNum(f);
             MesKey: Year(f)*100 + Month(f);
             Mes:    Upper(Text(f; "[$-en-US]mmm"))}));;

colMeses =
    SortByColumns(
        ForAll(Distinct(colSemanas; MesKey) As K;
            {MesKey: K.Value;
             Nom:    LookUp(colSemanas; MesKey = K.Value; Mes);
             Sem:    CountRows(Filter(colSemanas; MesKey = K.Value))});
        "MesKey"; SortOrder.Ascending);;

colTabs =
    Table({Cod:"TL";  Nom:"Timeline"};
          {Cod:"INV"; Nom:"Greenhouses"};
          {Cod:"VCR"; Nom:"VCR requests"};
          {Cod:"ASG"; Nom:"Assignment"};
          {Cod:"PAR"; Nom:"Parameters"});;

colOpcSitio =
    Table({Sitio:"Salama Station"};
          {Sitio:"Guatemala-EXT"});;

colOpcCriterio =
    Table({Modo:"vent";  Nom:"Shared planting window"};
          {Modo:"early"; Nom:"Same earliest start"});;

colOpcEstado =
    Table({Est:"PEND"; Nom:"Pending only"};
          {Est:"PART"; Nom:"Partial only"};
          {Est:"DONE"; Nom:"Assigned only"};
          {Est:"EXP";  Nom:"Expired only"};
          {Est:"";     Nom:"All VCR"});;

colOpcBloque =
    Ungroup(
        Table({o: Table({Bloque: ""; Nom: "All blocks"})};
              {o: ForAll(Distinct(colInv; Bloque) As B; {Bloque: B.Value; Nom: B.Value})});
        "o");;

colOpcInvAsg =
    Ungroup(
        Table({o: Table({Cod: ""; Nom: "All greenhouses"})};
              {o: ForAll(colInv As G; {Cod: G.Cod; Nom: G.Cod})});
        "o");;

colOpcCultivo =
    Ungroup(
        Table({o: Table({Cultivo: ""; Nom: "All crops"})};
              {o: ForAll(colCultivos As C; {Cultivo: C.Cultivo; Nom: C.Cultivo})});
        "o");;

colLeyenda =
    Ungroup(
        Table({o: ForAll(colCultivos As C; {Nom: C.Cultivo; Dias: C.Ciclo & " d"; Hex: C.Hex})};
              {o: Table({Nom:"Cleaning window"; Dias:""; Hex:"#e6e6dd"};
                        {Nom:"In production";   Dias:""; Hex:"#b9b8ac"})});
        "o");;


