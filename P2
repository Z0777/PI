<title>Planificador de Invernaderos</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap">
<style>
:root{
  color-scheme: light;
  --bg:#f4f4ef; --surface:#fdfdfb; --surface-2:#eeeee7; --surface-3:#e6e6dd;
  --ink:#12120e; --ink-2:#55544c; --muted:#84837a;
  --line:#e0dfd6; --line-2:#c7c6ba;
  --accent:#1f5c46; --accent-2:#2c7a5d; --on-accent:#ffffff;
  --good:#0ca30c; --warn:#fab219; --serious:#ec835a; --crit:#d03b3b;
  --Tomato:#2a78d6; --Pepper:#eb6834; --Melon:#eda100; --Watermelon:#1baf7a; --Cucumber:#e87ba4;
  --bloqueo:#b9b8ac;
  --sans:"IBM Plex Sans",system-ui,-apple-system,"Segoe UI",sans-serif;
  --disp:"Archivo","IBM Plex Sans",system-ui,sans-serif;
  --mono:"IBM Plex Mono",ui-monospace,SFMono-Regular,Menlo,monospace;
  --r:8px; --lbl:178px;
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    color-scheme: dark;
    --bg:#0d0d0c; --surface:#1a1a18; --surface-2:#232320; --surface-3:#2b2b27;
    --ink:#ffffff; --ink-2:#c3c2b7; --muted:#8e8d84;
    --line:#2c2c29; --line-2:#3c3c37;
    --accent:#3f9c77; --accent-2:#4fae86; --on-accent:#08130f;
    --Tomato:#3987e5; --Pepper:#d95926; --Melon:#c98500; --Watermelon:#199e70; --Cucumber:#d55181;
    --bloqueo:#4a4a44; --crit:#e66767;
  }
}
:root[data-theme="dark"]{
  color-scheme: dark;
  --bg:#0d0d0c; --surface:#1a1a18; --surface-2:#232320; --surface-3:#2b2b27;
  --ink:#ffffff; --ink-2:#c3c2b7; --muted:#8e8d84;
  --line:#2c2c29; --line-2:#3c3c37;
  --accent:#3f9c77; --accent-2:#4fae86; --on-accent:#08130f;
  --Tomato:#3987e5; --Pepper:#d95926; --Melon:#c98500; --Watermelon:#199e70; --Cucumber:#d55181;
  --bloqueo:#4a4a44; --crit:#e66767;
}
*{box-sizing:border-box}
body{background:var(--bg);color:var(--ink);font-family:var(--sans);font-size:13px;line-height:1.45;
  -webkit-text-size-adjust:100%}
.wrap{padding-inline:16px;padding-block:14px 40px;max-width:1560px;margin:0 auto;
  display:flex;flex-direction:column;gap:12px;min-width:0}
h1,h2,h3{font-family:var(--disp);margin:0;text-wrap:balance}
h1{font-size:19px;font-weight:700;letter-spacing:-.01em}
h2{font-size:15px;font-weight:600}
h3{font-size:12px;font-weight:600;text-transform:uppercase;letter-spacing:.07em;color:var(--muted);margin:16px 0 7px}
p{margin:0 0 8px}
.num{font-variant-numeric:tabular-nums}
.hint{font-size:11.5px;color:var(--muted)}
.mini{font-size:12px;color:var(--ink-2)}

/* ---- marcas de control ---- */
[data-ctl]{position:relative}
body.ctl [data-ctl]{outline:1px dashed color-mix(in srgb,var(--accent-2) 55%,transparent);outline-offset:-1px}
body.ctl [data-ctl]::before{content:attr(data-ctl);position:absolute;top:0;left:0;z-index:20;
  font-family:var(--mono);font-size:9px;line-height:1.5;padding:0 4px;pointer-events:none;
  background:var(--accent);color:var(--on-accent);border-radius:0 0 4px 0;white-space:nowrap}

/* ---- barra superior ---- */
.top{display:flex;flex-wrap:wrap;gap:12px;align-items:center;justify-content:space-between;
  background:var(--surface);border:1px solid var(--line);border-radius:var(--r);padding:11px 13px}
.brand{display:flex;gap:10px;align-items:center}
.brand .glyph{width:32px;height:32px;border-radius:7px;background:var(--accent);color:var(--on-accent);
  display:grid;place-items:center;font-family:var(--disp);font-weight:700;font-size:13px;flex:none}
.brand p{color:var(--muted);font-size:11.5px;margin:0}
.ctl{display:flex;gap:8px;align-items:flex-end;flex-wrap:wrap}
label.f{display:flex;flex-direction:column;gap:3px;font-size:10px;color:var(--muted);
  text-transform:uppercase;letter-spacing:.06em;font-weight:600}
select,input[type=date],input[type=number],input[type=text]{font-family:var(--sans);font-size:12.5px;
  background:var(--surface);color:var(--ink);border:1px solid var(--line-2);border-radius:6px;padding:5px 7px}
input[type=number]{width:72px;font-variant-numeric:tabular-nums}
.btn{font-family:var(--sans);font-size:12.5px;font-weight:500;background:var(--surface-2);color:var(--ink);
  border:1px solid var(--line-2);border-radius:6px;padding:7px 12px;cursor:pointer;white-space:nowrap}
.btn:hover{background:var(--surface-3)}
.btn.primary{background:var(--accent);border-color:var(--accent);color:var(--on-accent);font-weight:600}
.btn.primary:hover{background:var(--accent-2);border-color:var(--accent-2)}
.btn.mini{padding:3px 8px;font-size:11px}
.sw{display:flex;align-items:center;gap:6px;font-size:11.5px;color:var(--ink-2);cursor:pointer;
  border:1px solid var(--line-2);border-radius:99px;padding:5px 11px;background:var(--surface)}
.sw input{margin:0}
:focus-visible{outline:2px solid var(--accent-2);outline-offset:2px}

/* ---- aviso ---- */
.aviso{display:flex;gap:11px;align-items:flex-start;background:color-mix(in srgb,var(--warn) 13%,var(--surface));
  border:1px solid color-mix(in srgb,var(--warn) 45%,var(--line-2));border-radius:var(--r);padding:11px 13px}
.aviso b{font-family:var(--disp)}
.aviso .i{width:22px;height:22px;border-radius:50%;background:var(--warn);color:#3a2800;flex:none;
  display:grid;place-items:center;font-weight:700;font-size:13px;font-family:var(--disp)}

/* ---- kpis ---- */
.kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(168px,1fr));gap:9px}
.kpi{background:var(--surface);border:1px solid var(--line);border-radius:var(--r);padding:10px 12px}
.kpi .lab{font-size:10px;text-transform:uppercase;letter-spacing:.06em;color:var(--muted);font-weight:600}
.kpi .val{font-family:var(--disp);font-size:23px;font-weight:600;line-height:1.15;margin-top:2px;
  font-variant-numeric:tabular-nums}
.kpi .sub{font-size:11px;color:var(--ink-2)}
.kpi.ok .val{color:var(--good)} .kpi.mal .val{color:var(--crit)}

/* ---- tabs ---- */
.tabs{display:flex;gap:2px;flex-wrap:wrap;border-bottom:1px solid var(--line)}
.tab{font-family:var(--disp);font-size:12.5px;font-weight:600;background:none;border:none;
  border-bottom:2px solid transparent;color:var(--muted);padding:8px 13px;cursor:pointer;border-radius:6px 6px 0 0}
.tab:hover{color:var(--ink);background:var(--surface-2)}
.tab[aria-selected=true]{color:var(--ink);border-bottom-color:var(--accent)}

.card{background:var(--surface);border:1px solid var(--line);border-radius:var(--r);padding:13px}
.card + .card{margin-top:11px}
.card-hd{display:flex;gap:10px;align-items:baseline;justify-content:space-between;flex-wrap:wrap;margin-bottom:9px}

/* ---- leyenda ---- */
.legend{display:flex;gap:11px;flex-wrap:wrap;align-items:center;font-size:11.5px;color:var(--ink-2)}
.legend span{display:flex;gap:5px;align-items:center}
.dot{width:11px;height:11px;border-radius:3px;flex:none;display:inline-block}
.dot.vent{background:var(--surface-3);border:1px solid var(--line-2)}
.dot.prod{background:repeating-linear-gradient(45deg,var(--bloqueo) 0 3px,transparent 3px 6px);border:1px solid var(--line-2)}

/* ---- timeline ---- */
main,section,.card,.tw,.scroller{min-width:0;max-width:100%}
.scroller{overflow-x:auto;border:1px solid var(--line);border-radius:var(--r);background:var(--surface)}
.grid{min-width:1420px}
.row{display:grid;grid-template-columns:var(--lbl) 1fr;align-items:stretch}
.lbl{position:sticky;left:0;z-index:3;background:var(--surface);border-right:1px solid var(--line-2);
  padding:3px 9px;display:flex;align-items:center;gap:6px;justify-content:space-between}
.lbl .cod{font-family:var(--disp);font-weight:600;font-size:11.5px}
.lbl .cap{font-size:10px;color:var(--muted);font-variant-numeric:tabular-nums}
.track{position:relative;height:100%;
  background-image:linear-gradient(to right,var(--line) 0 1px,transparent 1px 100%);
  background-size:calc(100%/56) 100%}
.row.grp{background:var(--surface-2)}
.row.grp .lbl{background:var(--surface-2);font-family:var(--disp);font-weight:600;font-size:10.5px;
  text-transform:uppercase;letter-spacing:.06em;color:var(--ink-2);padding-block:5px}
.row.grp .track{background:var(--surface-2);border-bottom:1px solid var(--line-2)}
.row.gh{border-bottom:1px solid var(--line);height:30px}
.row.gh:hover .lbl{background:var(--surface-2)}
.row.gh .track{height:30px}
.ruler{position:sticky;top:0;z-index:4;background:var(--surface);border-bottom:1px solid var(--line-2)}
.ruler .lbl{background:var(--surface);z-index:5}
.months{position:relative;height:20px}
.months i{position:absolute;top:0;height:20px;border-left:1px solid var(--line-2);padding-left:4px;
  font-style:normal;font-size:10px;font-weight:600;color:var(--ink-2);text-transform:uppercase;
  letter-spacing:.05em;overflow:hidden;line-height:20px}
.weeks{position:relative;height:15px;border-top:1px solid var(--line)}
.weeks i{position:absolute;top:0;font-style:normal;font-size:9px;color:var(--muted);
  font-variant-numeric:tabular-nums;transform:translateX(-50%);white-space:nowrap;line-height:15px}
.bar{position:absolute;top:5px;height:20px;border-radius:4px;display:flex;align-items:center;
  padding:0 5px;font-size:9.5px;font-weight:600;color:#fff;overflow:hidden;white-space:nowrap;cursor:pointer;
  box-shadow:0 0 0 2px var(--surface)}
.bar:hover{filter:brightness(1.08)}
.seg-vent{position:absolute;top:5px;height:20px;background:var(--surface-3);border:1px solid var(--line-2);
  border-radius:0 4px 4px 0;box-sizing:border-box}
.seg-semi{position:absolute;top:11px;height:8px;border-radius:3px;
  background:repeating-linear-gradient(45deg,currentColor 0 2px,transparent 2px 4px);opacity:.7}
.blq{position:absolute;top:0;height:100%;background:repeating-linear-gradient(45deg,var(--bloqueo) 0 3px,transparent 3px 6px);
  opacity:.5;border-right:1px solid var(--line-2)}

/* ---- grafico ocupacion ---- */
.chartrow{border-top:2px solid var(--line-2)}
.chartrow .lbl{flex-direction:column;align-items:flex-start;gap:2px;justify-content:center;padding-block:8px}
.chart{position:relative;height:130px;display:flex;align-items:flex-end;padding:0 1px}
.gline{position:absolute;left:0;right:0;border-top:1px dashed var(--line);font-size:9px;color:var(--muted)}
.gline b{position:absolute;left:2px;top:-11px;font-weight:500;font-variant-numeric:tabular-nums}
.wk{position:relative;flex:1 1 0;height:100%;display:flex;flex-direction:column;justify-content:flex-end;
  align-items:center;min-width:0;z-index:1}
.wk i{display:block;width:70%;background:#2a78d6;border-radius:2px 2px 0 0}
.wk:hover{background:color-mix(in srgb,var(--accent) 13%,transparent)}

/* ---- tablas ---- */
.tw{overflow-x:auto}
table{border-collapse:collapse;width:100%;font-size:12px;min-width:640px}
th,td{text-align:left;padding:5px 9px;border-bottom:1px solid var(--line);vertical-align:middle}
th{font-family:var(--disp);font-size:10px;text-transform:uppercase;letter-spacing:.06em;color:var(--muted);
  font-weight:600;position:sticky;top:0;background:var(--surface);z-index:1;border-bottom:1px solid var(--line-2)}
td.n,th.n{text-align:right;font-variant-numeric:tabular-nums}
tbody tr:hover{background:var(--surface-2)}
tr.sel{background:color-mix(in srgb,var(--accent) 11%,transparent)}
.pill{display:inline-flex;align-items:center;gap:4px;font-size:10px;font-weight:600;padding:2px 7px;
  border-radius:99px;border:1px solid var(--line-2);background:var(--surface-2);color:var(--ink-2);white-space:nowrap}
.pill.ok{color:var(--good);border-color:color-mix(in srgb,var(--good) 45%,var(--line-2))}
.pill.late{color:var(--serious);border-color:color-mix(in srgb,var(--serious) 55%,var(--line-2))}
.pill.bad{color:var(--crit);border-color:color-mix(in srgb,var(--crit) 45%,var(--line-2))}
.meter{position:relative;height:7px;border-radius:99px;background:var(--surface-3);overflow:hidden;min-width:56px}
.meter i{position:absolute;left:0;top:0;bottom:0;border-radius:99px;background:var(--accent-2)}
.chips{display:flex;flex-wrap:wrap;gap:7px;margin-top:8px}
.chip{border:1px solid var(--line-2);border-radius:8px;background:var(--surface);padding:6px 9px;
  display:flex;align-items:center;gap:8px;font-size:11.5px}
.chip .gt{display:flex;flex-direction:column;line-height:1.3}
.chip .gt b{font-family:var(--disp);font-size:11.5px}
.chip .gt span{color:var(--muted);font-size:10px;font-variant-numeric:tabular-nums}

/* ---- flujo ---- */
.flow{display:grid;grid-template-columns:repeat(auto-fit,minmax(215px,1fr));gap:11px;margin:12px 0}
.step{background:var(--surface);border:1px solid var(--line);border-radius:var(--r);padding:12px;position:relative}
.step .n{font-family:var(--disp);font-size:10px;font-weight:700;color:var(--on-accent);background:var(--accent);
  width:20px;height:20px;border-radius:5px;display:grid;place-items:center;margin-bottom:7px}
.step h4{font-family:var(--disp);font-size:12.5px;margin:0 0 4px}
.step p{font-size:11.5px;color:var(--ink-2);margin:0}
.step code{font-size:11px}
code{font-family:var(--mono);font-size:11.5px;background:var(--surface-2);border:1px solid var(--line);
  border-radius:4px;padding:1px 4px}
pre{margin:9px 0;background:var(--surface-2);border:1px solid var(--line-2);border-radius:7px;padding:10px 11px;
  overflow-x:auto;font-family:var(--mono);font-size:11.5px;line-height:1.55}
pre code{background:none;border:none;padding:0}
.note{border-left:3px solid var(--accent-2);background:var(--surface-2);border-radius:0 7px 7px 0;
  padding:9px 12px;margin:10px 0}
.note.crit{border-left-color:var(--crit)}
.note p:last-child{margin-bottom:0}
ol,ul{margin:0 0 8px;padding-left:19px} li{margin-bottom:4px}

/* ---- popup ---- */
.modal[hidden]{display:none}
.modal{position:fixed;inset:0;z-index:70;display:flex;align-items:center;justify-content:center;padding:14px}
.modal-bd{position:absolute;inset:0;background:rgba(8,8,6,.55)}
.modal-box{position:relative;background:var(--surface);border:1px solid var(--line-2);border-radius:10px;
  box-shadow:0 20px 60px rgba(0,0,0,.35);width:min(900px,100%);max-height:86vh;overflow:auto}
.modal-hd{position:sticky;top:0;background:var(--surface);border-bottom:1px solid var(--line-2);padding:11px 13px;
  display:flex;gap:12px;align-items:flex-start;justify-content:space-between;z-index:2}
.modal-in{padding:13px}
.lote{border:1px solid var(--line);border-radius:8px;padding:9px 11px;margin-bottom:9px}
.lote.act{border-color:var(--accent-2);box-shadow:0 0 0 2px color-mix(in srgb,var(--accent-2) 20%,transparent)}
.lote-hd{display:flex;gap:9px;justify-content:space-between;align-items:center;flex-wrap:wrap;margin-bottom:6px}
.lote-hd .t{font-family:var(--disp);font-weight:600;font-size:12.5px;display:flex;align-items:center;gap:6px}
.lote table{min-width:0} .lote td,.lote th{padding:4px 6px;font-size:11px}
#tip{position:fixed;z-index:60;pointer-events:none;opacity:0;transition:opacity .09s;max-width:290px;
  background:var(--surface);color:var(--ink);border:1px solid var(--line-2);border-radius:7px;
  box-shadow:0 8px 26px rgba(0,0,0,.18);padding:9px 11px;font-size:11.5px}
#tip h4{font-family:var(--disp);font-size:12px;margin:0 0 4px}
#tip .kv{display:flex;justify-content:space-between;gap:14px;color:var(--ink-2)}
#tip .kv b{color:var(--ink);font-weight:600;font-variant-numeric:tabular-nums}
@media (max-width:760px){ :root{--lbl:118px} .grid{min-width:1360px} h1{font-size:17px} }
</style>

<div class="wrap">
  <header class="top" data-ctl="conHeader">
    <div class="brand" data-ctl="conMarca">
      <span class="glyph">IV</span>
      <div>
        <h1>Planificador de invernaderos</h1>
        <p>Salama Station · campaña 2026 · 186 VCR · 33 casas</p>
      </div>
    </div>
    <div class="ctl" data-ctl="conCtrl">
      <label class="f">Ventana<input type="number" id="pVent" value="7" min="0" max="45"></label>
      <label class="f">Agrupar ±d<input type="number" id="pGrp" value="10" min="0" max="45"></label>
      <label class="f">Sobrecupo %<input type="number" id="pSob" value="5" min="0" max="25"></label>
      <button class="btn primary" id="btnAuto">Asignar automáticamente</button>
      <button class="btn" id="btnLimpiar">Limpiar</button>
      <label class="sw"><input type="checkbox" id="swCtl"> Nombres de control</label>
    </div>
  </header>

  <div class="aviso" id="aviso">
    <span class="i">!</span>
    <div>
      <b>¿Tu app no muestra nada?</b> No es el diseño: <code>PLN_VCR</code> está vacía o sin conectar.
      El motor lee <code>colVCRsp = Filter(PLN_VCR; Anio = varAnio; SiteName = varSitio)</code>, y si esa
      consulta no devuelve filas, <code>colVCR</code> queda vacía y no hay nada que planificar.
      La pestaña <b>Cómo cargar los VCR</b> tiene los cuatro pasos.
      <button class="btn mini" id="btnFlujo" style="margin-left:8px">Ver ahora</button>
    </div>
  </div>

  <section class="kpis" id="kpis" data-ctl="galKPI"></section>

  <nav class="tabs" role="tablist" data-ctl="galTabs">
    <button class="tab" role="tab" data-t="TL" aria-selected="true">Línea de tiempo</button>
    <button class="tab" role="tab" data-t="INV" aria-selected="false">Invernaderos</button>
    <button class="tab" role="tab" data-t="VCR" aria-selected="false">Solicitudes VCR</button>
    <button class="tab" role="tab" data-t="ASG" aria-selected="false">Asignación</button>
    <button class="tab" role="tab" data-t="PAR" aria-selected="false">Parámetros</button>
    <button class="tab" role="tab" data-t="FLU" aria-selected="false">Cómo cargar los VCR</button>
  </nav>

  <main data-ctl="conBody">
    <!-- ============ LÍNEA DE TIEMPO ============ -->
    <section id="tab-TL" data-ctl="conTL">
      <div class="card">
        <div class="card-hd" data-ctl="conFiltrosTL">
          <div>
            <h2>Ocupación por invernadero, semana a semana</h2>
            <p class="hint">Cada barra es un ciclo: del trasplante al fin de cosecha, más la ventana de limpieza.
              El rayado previo es el tiempo en semillero. 56 semanas desde el 1 de noviembre.</p>
          </div>
          <div class="ctl">
            <label class="f">Bloque<select id="fBloque"></select></label>
            <label class="f">Cultivo<select id="fCultivo"></select></label>
          </div>
        </div>
        <div class="legend" id="leyenda" data-ctl="galLeyenda"></div>
        <div class="scroller" style="margin-top:9px">
          <div class="grid" id="tl" data-ctl="galTimeline"></div>
        </div>
        <p class="hint" style="margin-top:7px">Clic en una barra para abrir la casa y ver sus VCR.</p>
      </div>
    </section>

    <!-- ============ INVERNADEROS ============ -->
    <section id="tab-INV" hidden data-ctl="conINV">
      <div class="card">
        <div class="card-hd">
          <div><h2>Capacidad instalada</h2>
            <p class="hint">Capacidad = área × densidad. «Disponible desde» libera la casa cuando termina el ciclo que hoy está en producción.</p></div>
          <span class="pill" id="capTot"></span>
        </div>
        <div class="tw"><table id="tInv" data-ctl="galInv"></table></div>
      </div>
    </section>

    <!-- ============ VCR ============ -->
    <section id="tab-VCR" hidden data-ctl="conVCR">
      <div class="card">
        <div class="card-hd"><div><h2>Solicitudes de siembra</h2>
          <p class="hint">Origen: <code>PLN_VCR</code>. Ocho columnas del archivo; las demás no influyen en la distribución.</p></div></div>
        <div data-ctl="conGrupos">
          <h3>Grupos por ventana compartida</h3>
          <div class="chips" id="grupos" data-ctl="galGrupos"></div>
        </div>
        <div class="tw" style="margin-top:12px"><table id="tVcr" data-ctl="galVCR"></table></div>
      </div>
    </section>

    <!-- ============ ASIGNACIÓN ============ -->
    <section id="tab-ASG" hidden data-ctl="conASG">
      <div class="card">
        <div class="card-hd"><div><h2>Resumen por invernadero</h2>
          <p class="hint">Ciclos logrados en el año y aprovechamiento de la capacidad.</p></div></div>
        <div class="tw"><table id="tRes" data-ctl="galResumen"></table></div>
      </div>
      <div class="card">
        <div class="card-hd"><div><h2>Detalle de asignación</h2>
          <p class="hint">Una fila por VCR y por invernadero: un VC
