11. BOTON "RELOAD CATALOGS"
==============================================================================

Para cuando edites SharePoint con la app abierta y no quieras cerrarla.

Control:    btnRecargar          <- CONTROL NUEVO
Tipo:       Classic/Button
Ubicacion:  conApp > conHeader > conCtrl   (junto a btnGuardar)
Propiedades a fijar:
   Text      ="Reload catalogs"
   Width     =150
   Height    =35
   Fill      =RGBA(31; 92; 70; 1)
   Color     =RGBA(255; 255; 255; 1)
   Size      =10
   OnSelect  (ver abajo)

=Refresh(PLN_Config);;
Refresh(PLN_Parametros);;
Refresh(PLN_INVERNADEROS);;
Refresh(PLN_VCR);;

ClearCollect(colCfgSp; PLN_Config);;
Set(varAgrupar;       Coalesce(LookUp(colCfgSp; Title = "Agrupar").Valor; 10));;
Set(varSobre;         Coalesce(LookUp(colCfgSp; Title = "Sobre").Valor; 5));;
Set(varProx;          Coalesce(LookUp(colCfgSp; Title = "Prox").Valor; 10));;
Set(varVentanaGlobal; Coalesce(LookUp(colCfgSp; Title = "Ventana").Valor; 7));;
Set(varGracia;        Coalesce(LookUp(colCfgSp; Title = "Gracia").Valor; 20));;

ClearCollect(colParSp; PLN_Parametros);;
ClearCollect(colCultivos;
    ForAll(colParSp As C;
        {Cultivo:   C.Cultivo;
         ES:        C.NombreES;
         Familia:   C.Familia;
         Semillero: C.DiasSemillero;
         Ciclo:     C.DiasCiclo;
         Ventana:   C.DiasVentana;
         Hex:       C.ColorHex}));;

ClearCollect(colInvSp; PLN_INVERNADEROS);;
ClearCollect(colInv;
    SortByColumns(
        ForAll(Filter(colInvSp; Activo <> false) As G;
            {Cod:      G.Codigo;
             Bloque:   G.Bloque;
             Tipo:     "Transplant";
             Cultivos: G.CultivosPermitidos;
             Area:     G.AreaM2;
             Dens:     G.DensidadPlM2;
             Cap:      G.CapacidadPlantas;
             Disp:     G.DisponibleDesde;
             Orden:    G.Orden});
        "Orden"; SortOrder.Ascending));;

Select(btnRecalcular);;
Notify("Catalogos recargados desde SharePoint"; NotificationType.Success)

Refresh() le dice a Power Apps que tire su cache de esa lista y vuelva a
preguntarle a SharePoint. Sin el, aunque vuelvas a hacer ClearCollect, te
sirve los mismos datos viejos que ya tenia en memoria.

